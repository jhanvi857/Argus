DATABASE_URL=postgresql://postgres:postgres@localhost:5432/argus
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=argus

# Set to your backend API URL. Works for localhost (http://localhost:8000) or deployed API (https://api.yourdomain.com)
BACKEND_URL=http://localhost:8000
VITE_BACKEND_URL=http://localhost:8000

# ------------------------------------------------------------------------------
# Resend Email Configuration (Localhost & Production Deployment)
# ------------------------------------------------------------------------------
# Get your API key from https://resend.com
# On localhost: leaving this unset or empty enables dev mode (OTP shown in logs/API)
RESEND_API_KEY=re_your_resend_api_key_here
RESEND_FROM_EMAIL=Argus <onboarding@resend.dev>

# Recipient Email for ATS Opportunity Alerts & Digest
NOTIFICATION_EMAIL_TO=candidate_recipient@example.com
NOTIFICATION_EMAIL_FROM=Argus <onboarding@resend.dev>
EMAIL_SUBJECT_PREFIX=[Argus Alert]

# Optional Resend SMTP Fallback (for legacy mailers or n8n SMTP node)
# Resend SMTP documentation: https://resend.com/docs/dashboard/emails/smtp
SMTP_HOST=smtp.resend.com
SMTP_PORT=465
SMTP_USER=resend
SMTP_PASSWORD=re_your_resend_api_key_here
SMTP_USE_TLS=false
SMTP_USE_SSL=true

GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.1-8b-instant

# Gemini (Grounded Matcher Graph — Phase 6): https://aistudio.google.com
GEMINI_API_KEY=your_gemini_api_key_here

CRON_SECRET=
ARGUS_CRON_SECRET=

