# ==============================================================================
# Argus Configuration Environment Variables
# ==============================================================================

# ------------------------------------------------------------------------------
# PostgreSQL Database Configuration
# ------------------------------------------------------------------------------
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/argus
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=argus

RESEND_API_KEY=re_your_resend_api_key_here
RESEND_FROM_EMAIL=Argus <onboarding@resend.dev>

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASSWORD=your_app_password_here
SMTP_USE_TLS=true
SMTP_USE_SSL=false

# Notification Addresses
NOTIFICATION_EMAIL_TO=candidate_recipient@example.com
NOTIFICATION_EMAIL_FROM=your_email@gmail.com
EMAIL_SUBJECT_PREFIX=[Argus Alert]

GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.1-8b-instant

# Gemini (Grounded Matcher Graph — Phase 6): https://aistudio.google.com
GEMINI_API_KEY=your_gemini_api_key_here

N8N_PORT=5678
N8N_HOST=localhost
N8N_PROTOCOL=http
N8N_EDITOR_BASE_URL=http://localhost:5678/
GENERIC_TIMEZONE=UTC
