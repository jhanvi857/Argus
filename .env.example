# ==============================================================================
# Argus Configuration Environment Variables
# ==============================================================================

# ------------------------------------------------------------------------------
# PostgreSQL Database Configuration
# ------------------------------------------------------------------------------
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/argus
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=argus

# ------------------------------------------------------------------------------
# Email (SMTP) Notification Settings
# ------------------------------------------------------------------------------
# For Gmail: Use smtp.gmail.com with an App Password (not your normal password).
# See: https://myaccount.google.com/apppasswords
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASSWORD=your_app_password_here
SMTP_USE_TLS=true
SMTP_USE_SSL=false

# Notification Addresses
NOTIFICATION_EMAIL_TO=candidate_recipient@example.com
NOTIFICATION_EMAIL_FROM=your_email@gmail.com
EMAIL_SUBJECT_PREFIX=[Argus Alert]

# ------------------------------------------------------------------------------
# Local Docker & n8n Configuration
# ------------------------------------------------------------------------------
N8N_PORT=5678
N8N_HOST=localhost
N8N_PROTOCOL=http
N8N_EDITOR_BASE_URL=http://localhost:5678/
GENERIC_TIMEZONE=UTC
